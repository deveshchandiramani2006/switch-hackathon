# ── SLACK ──────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_APP_TOKEN=xapp-your-token-here
SLACK_WORKSPACE_ID=T0XXXXXXX

SLACK_ROOM_SALES=#nexus-sales
SLACK_ROOM_SUPPORT=#nexus-support
SLACK_ROOM_GROWTH=#nexus-growth
SLACK_ROOM_CONTENT=#nexus-content
SLACK_ROOM_DEVOPS=#nexus-devops

# ── SWITCH ─────────────────────────────────────────────────
SWITCH_SERVER_URL=http://localhost:8080
SWITCH_REGISTRATION_KEY=your-switch-registration-key-here
# Room IDs — get from Switch Console after creating rooms
SWITCH_ROOM_ID_SALES=
SWITCH_ROOM_ID_SUPPORT=
SWITCH_ROOM_ID_GROWTH=
SWITCH_ROOM_ID_CONTENT=
SWITCH_ROOM_ID_DEVOPS=
# Agent IDs and API keys — auto-generated by switch_setup.py
SWITCH_AGENT_ID_SALES=
SWITCH_API_KEY_SALES=
SWITCH_AGENT_ID_SUPPORT=
SWITCH_API_KEY_SUPPORT=
SWITCH_AGENT_ID_GEOSEO=
SWITCH_API_KEY_GEOSEO=
SWITCH_AGENT_ID_BLOG=
SWITCH_API_KEY_BLOG=
SWITCH_AGENT_ID_INFRA=
SWITCH_API_KEY_INFRA=

# ── LLM — Cloud (Sales, Support, GeoSEO) ───────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6

# ── LLM — Local via Ollama (Blog, Infra) ───────────────────
OLLAMA_BASE_URL=http://localhost:11434
BLOG_LLM_PROVIDER=ollama
BLOG_LLM_MODEL=mistral
INFRA_LLM_PROVIDER=ollama
INFRA_LLM_MODEL=phi3

# ── SEO ─────────────────────────────────────────────────────
SERPAPI_KEY=your-serpapi-key-here
SEO_COUNTRY=IN
SEO_LANGUAGE=en
GEO_SEO_MOCK_MODE=false

# ── BLOG API ────────────────────────────────────────────────
BLOG_API_ENDPOINT=https://yourblog.com/api/posts
BLOG_API_TOKEN=your-blog-api-token
BLOG_API_ADAPTER=custom
BLOG_MOCK_MODE=false

# ── VOICE / WHISPER ─────────────────────────────────────────
WHISPER_MODE=local
WHISPER_MODEL=base

# ── DATABASE ────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus

# ── APP ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
ESCALATION_CHECK_MINUTES=60
GEO_SEO_INTERVAL_HOURS=24
