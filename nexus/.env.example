# ── SLACK ──────────────────────────────────────────────────────────────────────
# Set these to run agents in Slack instead of Switch.
# Get tokens from https://api.slack.com/apps → your app → OAuth & Permissions / Basic Information
SLACK_BOT_TOKEN=                    # xoxb-...  Bot User OAuth Token
SLACK_APP_TOKEN=                    # xapp-...  App-Level Token (connections:write scope)

# Slack channel IDs for each agent (Channel ID, not name — right-click channel → Copy link)
SLACK_CHANNEL_ID_SALES=
SLACK_CHANNEL_ID_SUPPORT=
SLACK_CHANNEL_ID_CS=
SLACK_CHANNEL_ID_FINANCE=
SLACK_CHANNEL_ID_GROWTH=
SLACK_CHANNEL_ID_CONTENT=
SLACK_CHANNEL_ID_DEVOPS=

# ── SWITCH ─────────────────────────────────────────────────────────────────────
SWITCH_SERVER_URL=http://localhost:8080
SWITCH_REGISTRATION_KEY=your-switch-registration-key-here

# Room IDs — created in Switch Console, then set here
SWITCH_ROOM_ID_SALES=
SWITCH_ROOM_ID_SUPPORT=
SWITCH_ROOM_ID_CS=
SWITCH_ROOM_ID_FINANCE=
SWITCH_ROOM_ID_GROWTH=
SWITCH_ROOM_ID_CONTENT=
SWITCH_ROOM_ID_DEVOPS=

# Agent credentials — populated by: python artisan.py register-agents
SWITCH_AGENT_ID_SALES=
SWITCH_API_KEY_SALES=
SWITCH_AGENT_ID_SUPPORT=
SWITCH_API_KEY_SUPPORT=
SWITCH_AGENT_ID_CS=
SWITCH_API_KEY_CS=
SWITCH_AGENT_ID_FINANCE=
SWITCH_API_KEY_FINANCE=
SWITCH_AGENT_ID_GEOSEO=
SWITCH_API_KEY_GEOSEO=
SWITCH_AGENT_ID_BLOG=
SWITCH_API_KEY_BLOG=
SWITCH_AGENT_ID_INFRA=
SWITCH_API_KEY_INFRA=

# Voice agent — posts transcribed commands back to Switch rooms
SWITCH_AGENT_ID_VOICE=
SWITCH_API_KEY_VOICE=

# ── DATABASE ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus

# ── MULTI-TENANCY ───────────────────────────────────────────────────────────────
# One value per container — Docker Compose sets this per service
TENANT_ID=default

# ── MANAGEMENT API ──────────────────────────────────────────────────────────────
NEXUS_MASTER_KEY=change-me-in-production
MANAGEMENT_API_PORT=5000
VOICE_SERVER_PORT=5001

# ── LLM — PRIMARY (Anthropic) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6

# ── LLM — FALLBACK / LOCAL ──────────────────────────────────────────────────────
# Optional second provider before Ollama last-resort
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=

OLLAMA_BASE_URL=http://localhost:11434
# Default model for all agents — override per-agent below
OLLAMA_MODEL=llama3.2:latest

# Per-agent overrides (defaults: ollama + OLLAMA_MODEL)
SALES_LLM_PROVIDER=ollama
SALES_LLM_MODEL=llama3.2:latest
SUPPORT_LLM_PROVIDER=ollama
SUPPORT_LLM_MODEL=llama3.2:latest
CS_LLM_PROVIDER=ollama
CS_LLM_MODEL=llama3.2:latest
FINANCE_LLM_PROVIDER=ollama
FINANCE_LLM_MODEL=llama3.2:latest
GEOSEO_LLM_PROVIDER=ollama
GEOSEO_LLM_MODEL=llama3.2:latest
BLOG_LLM_PROVIDER=ollama
BLOG_LLM_MODEL=llama3.2:latest
INFRA_LLM_PROVIDER=ollama
INFRA_LLM_MODEL=llama3.2:latest

# Other optional providers
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# ── GEO (Generative Engine Optimization) ────────────────────────────────────────
# OpenAI-compatible API endpoint — swap base_url/key for real OpenAI, Groq, etc.
GEO_API_BASE=http://localhost:11434/v1   # Ollama local by default
GEO_API_KEY=ollama                       # any string for Ollama; real key for OpenAI
GEO_MODEL=llama3.2:latest               # model to use for scoring + recommendations
GEO_TARGET_DOMAIN=yourdomain.com        # domain to look for in AI citations
GEO_CHECK_INTERVAL_HOURS=12
GEO_BRAVE_API_KEY=                      # optional: Brave Search free tier (2000/mo)

# ── SEO ─────────────────────────────────────────────────────────────────────────
SERPAPI_KEY=your-serpapi-key-here
SEO_COUNTRY=IN
SEO_LANGUAGE=en
GEO_SEO_MOCK_MODE=true          # set false when SERPAPI_KEY is real

# ── BLOG / CMS ──────────────────────────────────────────────────────────────────
BLOG_API_ENDPOINT=https://yourblog.com/api/posts
BLOG_API_TOKEN=your-blog-api-token
BLOG_API_ADAPTER=custom         # custom | wordpress | ghost
BLOG_MOCK_MODE=true             # set false to actually publish

# ── EMAIL (escalation fallback) ─────────────────────────────────────────────────
# SendGrid — takes priority if set
SENDGRID_API_KEY=

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=nexus@yourdomain.com

# ── BILLING (Stripe) ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_MOCK_MODE=true          # set false with real Stripe keys

# ── VOICE / WHISPER ─────────────────────────────────────────────────────────────
WHISPER_MODEL=base              # base | small | medium | large

# ── SCHEDULER TUNING ────────────────────────────────────────────────────────────
ESCALATION_CHECK_MINUTES=60     # set 1 for demo
GEO_SEO_INTERVAL_HOURS=24
PROACTIVE_INTERVAL_HOURS=6
APPROVAL_TIMEOUT_HOURS=48

# ── FEATURE THRESHOLDS ──────────────────────────────────────────────────────────
DEAL_SILENCE_ALERT_DAYS=7
RANK_DROP_THRESHOLD=5
BUDGET_WARN_PCT=75

# ── LOGGING ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
