FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app/ ./app/
COPY config/ ./config/
COPY routes/ ./routes/
COPY bootstrap/ ./bootstrap/
COPY database/ ./database/
ENV PYTHONPATH=/app
EXPOSE 5000
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5000", "--timeout", "60", "bootstrap.api:app"]
