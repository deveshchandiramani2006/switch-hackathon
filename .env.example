# ── SWITCH (primary transport) ─────────────────────────────────────────────────
# Download Switch Console: https://switchagents.ai
# Start it, create 7 rooms (one per agent), then run: python register_agents.py

SWITCH_SERVER_URL=http://localhost:8080
SWITCH_REGISTRATION_KEY=your-switch-registration-key-here

# Room IDs — create these in Switch Console, bridge to your Slack workspace
SWITCH_ROOM_ID_SALES=
SWITCH_ROOM_ID_SUPPORT=
SWITCH_ROOM_ID_CS=
SWITCH_ROOM_ID_FINANCE=
SWITCH_ROOM_ID_GROWTH=
SWITCH_ROOM_ID_CONTENT=
SWITCH_ROOM_ID_DEVOPS=

# Agent credentials — populated by: python register_agents.py
SWITCH_AGENT_ID_SALES=
SWITCH_API_KEY_SALES=
SWITCH_AGENT_ID_SUPPORT=
SWITCH_API_KEY_SUPPORT=
SWITCH_AGENT_ID_CS=
SWITCH_API_KEY_CS=
SWITCH_AGENT_ID_FINANCE=
SWITCH_API_KEY_FINANCE=
SWITCH_AGENT_ID_GEOSEO=
SWITCH_API_KEY_GEOSEO=
SWITCH_AGENT_ID_BLOG=
SWITCH_API_KEY_BLOG=
SWITCH_AGENT_ID_INFRA=
SWITCH_API_KEY_INFRA=

# ── SLACK (Slack app bridged via Switch Console) ────────────────────────────────
# Switch Console connects your Slack workspace to Switch rooms.
# These are only needed if running agents with Slack Bolt directly (no Switch Console).
SLACK_BOT_TOKEN=                    # xoxb-...
SLACK_APP_TOKEN=                    # xapp-...
SLACK_CHANNEL_ID_SALES=
SLACK_CHANNEL_ID_SUPPORT=
SLACK_CHANNEL_ID_CS=
SLACK_CHANNEL_ID_FINANCE=
SLACK_CHANNEL_ID_GROWTH=
SLACK_CHANNEL_ID_CONTENT=
SLACK_CHANNEL_ID_DEVOPS=

# ── DATABASE ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus_dev@localhost:5432/nexus

# ── LLM — PRIMARY ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-sonnet-4-6

# ── LLM — LOCAL FALLBACK ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Per-agent LLM overrides (defaults to Ollama if Anthropic key not set)
SALES_LLM_PROVIDER=ollama
SALES_LLM_MODEL=llama3.2:latest
SUPPORT_LLM_PROVIDER=ollama
SUPPORT_LLM_MODEL=llama3.2:latest
CS_LLM_PROVIDER=ollama
CS_LLM_MODEL=llama3.2:latest
FINANCE_LLM_PROVIDER=ollama
FINANCE_LLM_MODEL=llama3.2:latest
GEOSEO_LLM_PROVIDER=ollama
GEOSEO_LLM_MODEL=llama3.2:latest
BLOG_LLM_PROVIDER=ollama
BLOG_LLM_MODEL=llama3.2:latest
INFRA_LLM_PROVIDER=ollama
INFRA_LLM_MODEL=llama3.2:latest

# ── GEO (Generative Engine Optimization) ────────────────────────────────────────
GEO_API_BASE=http://localhost:11434/v1
GEO_API_KEY=ollama
GEO_MODEL=llama3.2:latest
GEO_TARGET_DOMAIN=yourdomain.com
GEO_CHECK_INTERVAL_HOURS=12
GEO_BRAVE_API_KEY=
GEO_SEO_MOCK_MODE=true

# ── SEO ─────────────────────────────────────────────────────────────────────────
SERPAPI_KEY=your-serpapi-key-here
SEO_COUNTRY=IN
SEO_LANGUAGE=en

# ── BLOG / CMS ──────────────────────────────────────────────────────────────────
BLOG_API_ENDPOINT=https://yourblog.com/api/posts
BLOG_API_TOKEN=your-blog-api-token
BLOG_API_ADAPTER=custom
BLOG_MOCK_MODE=true

# ── MULTI-TENANCY ───────────────────────────────────────────────────────────────
TENANT_ID=default
NEXUS_MASTER_KEY=change-me-in-production
MANAGEMENT_API_PORT=5000

# ── EMAIL (escalation — Level 3+ fires real email) ──────────────────────────────
# Mailtrap sandbox (demo): SMTP_HOST=sandbox.smtp.mailtrap.io SMTP_PORT=587
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_USER=you@gmail.com SMTP_PASSWORD=app-password
# Leave all blank to skip sending (Slack cards still fire normally)
SENDGRID_API_KEY=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=nexus@nexus.ai

# ── SCHEDULER TUNING ────────────────────────────────────────────────────────────
ESCALATION_CHECK_MINUTES=60
GEO_SEO_INTERVAL_HOURS=24
PROACTIVE_INTERVAL_HOURS=6

# ── FEATURE FLAGS ───────────────────────────────────────────────────────────────
BILLING_MOCK_MODE=true
DEAL_SILENCE_ALERT_DAYS=7
LOG_LEVEL=INFO
